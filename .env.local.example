# Self-hosted Supabase (binary_db)
# IMPORTANT: ANON / SERVICE_ROLE keys MUST match this server's JWT_SECRET.
# The default "supabase-demo" JWTs will fail with JWSInvalidSignature.

SUPABASE_URL=https://support-superbase.urbinaryhub.rw
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-from-selfhosted-env
SUPABASE_PUBLISHABLE_KEY=replace-with-anon-key-from-selfhosted-env

VITE_SUPABASE_URL=https://support-superbase.urbinaryhub.rw
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-key-from-selfhosted-env
VITE_SUPABASE_PROJECT_ID=binary_db

RESEND_API_KEY=your_resend_api_key
APPLICATION_FROM_EMAIL=UR Binary Hub <applications@yourdomain.com>
